# datazen-server 环境变量清单（WR-G3「环境变量清单对齐 config.rs 全键」）。
#
# 与 server/src/config.rs 的 23 个键逐一对齐；缺省值 = config.rs 的
# DEFAULT_* 常量。复制为 deploy/config/.env（chmod 600）后由 compose 注入。
# 纪律（team-service-operations §2）：秘密只用受控渠道注入，不进镜像、
# 不进命令行、不进日志；不得以读取本地 .env 内容作为运维核验步骤。

# ── 进程与监听 ──
# 监听地址。容器内绑 0.0.0.0:8080，由反代（单源 HTTPS）对外。
DATAZEN_SERVER_LISTEN=0.0.0.0:8080
# tracing EnvFilter 表达式。
DATAZEN_SERVER_LOG=info

# ── 管理库（SQLite，单文件 + WAL）──
# 卷内绝对路径；备份/恢复脚本读写该文件（deploy/scripts/*.sh）。
DATAZEN_SERVER_DB=/var/lib/datazen/datazen-admin.sqlite

# ── 密钥（fail-closed）──
# CSRF 与 policyIsolationKey 的 HMAC 主钥；显式注入要求 ≥32 字符。
# 未注入 = 开发默认值 + 启动 warn —— 生产必须显式注入（见运维手册 §3）。
DATAZEN_SERVER_SECRET=change-me-to-a-32-plus-char-random-value

# ── 会话寿命（秒；≥60；空闲窗不得越过绝对窗，否则拒绝启动）──
DATAZEN_SERVER_SESSION_IDLE_SECS=28800
DATAZEN_SERVER_SESSION_ABSOLUTE_SECS=86400

# ── 组织（单组织 v1）──
DATAZEN_SERVER_ORGANIZATION_ID=datazen-local-org

# ── 公网身份与 OIDC（三件套必须成套；配置 OIDC 必须同时给 public_origin）──
# 形态校验：scheme://host[:port]，无路径。
DATAZEN_SERVER_PUBLIC_ORIGIN=
DATAZEN_SERVER_OIDC_ISSUER=
DATAZEN_SERVER_OIDC_CLIENT_ID=
# 机密客户端可缺省（纯 PKCE 公开客户端）。
DATAZEN_SERVER_OIDC_CLIENT_SECRET=

# ── SSE ──
DATAZEN_SERVER_SSE_KEEPALIVE_SECS=15
DATAZEN_SERVER_SSE_MAX_BACKLOG=256

# ── L5 速率限制（默认档 + 严格档；键表上界防未认证 IP 内存攻击面）──
DATAZEN_SERVER_RATE_DEFAULT_CAPACITY=120
DATAZEN_SERVER_RATE_DEFAULT_REFILL=20.0
DATAZEN_SERVER_RATE_STRICT_CAPACITY=10
DATAZEN_SERVER_RATE_STRICT_REFILL=1.0
DATAZEN_SERVER_RATE_MAX_ENTRIES=65536

# ── 产物存储（WR-D7 受控上传/下载）──
DATAZEN_SERVER_ARTIFACT_ROOT=/var/lib/datazen/artifacts
DATAZEN_SERVER_ARTIFACT_TTL_SWEEP_SECS=300

# ── 预算额度（WR-D4/D6 协调器；单实例 = 节点额度即全局额度）──
DATAZEN_SERVER_BUDGET_NODE_LIMIT=64
DATAZEN_SERVER_BUDGET_ORGANIZATION_LIMIT=32
