{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataZen",
  "version": "0.0.9",
  "identifier": "com.tbeasy.datazen",
  "build": {
    "beforeDevCommand": "pnpm exec vite",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DataZen",
        "width": 680,
        "height": 480,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "backgroundColor": "#0f172a",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: tauri: blob:",
        "font-src": "'self' blob: data:",
        "connect-src": "'self' https: http: ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "capabilities": [
        "default"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFJFUExBQ0VfQkVGT1JFX0ZJUlNUX1JFTEVBU0UKUldRL1JlcGxhY2Ugd2l0aCBvdXRwdXQgb2YgdGF1cmkgc2lnbmVyIGdlbmVyYXRl",
      "endpoints": [
        "https://github.com/flyxl/datazen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "resources": {
      "resources/prompts": "prompts"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "BF659D0FC377388E2F2C64A479911D0866E35759",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.comodoca.com"
    }
  }
}
