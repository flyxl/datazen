{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DataZen",
  "version": "0.0.7",
  "identifier": "com.tbeasy.datazen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "DataZen",
        "width": 680,
        "height": 480,
        "minWidth": 520,
        "minHeight": 400,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "transparent": false,
        "visible": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: asset: tauri:",
        "connect-src": "'self' https: http: ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "BF659D0FC377388E2F2C64A479911D0866E35759",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.comodoca.com"
    }
  }
}
