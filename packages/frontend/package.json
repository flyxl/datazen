  "exports": {
    ".": "./src/index.ts",
    "./src/*.css": "./src/*.css",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "@datazen/backend-client": "workspace:*",
    "@datazen/driver-sdk": "workspace:*",
    "@datazen/extension-points": "workspace:*",
    "@datazen/ui": "workspace:*",
    "@datazen/wapp-sdk": "workspace:*",
    "@dagrejs/dagre": "^3.1.1",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.6",
    "@xyflow/react": "^12.11.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.487.0",
    "marked": "^18.0.9",
    "recharts": "^3.10.1",
    "sql-formatter": "^15.6.10",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "zustand": "^5.0.0",
