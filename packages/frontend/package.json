    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11"
  },
  "devDependencies": {
    "@codemirror/theme-one-dark": "6.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2"
  }
