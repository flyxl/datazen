{
  "name": "@datazen/frontend",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "DataZen shared frontend tree: stores, windows, components, hooks and the platform port contracts — everything the desktop app renders except the app shell itself. Source-package mode: consumers import TypeScript directly, no build step.",
