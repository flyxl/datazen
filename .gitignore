!/packages/drivers/victoriametrics/**

# Re-ignore junk that the packages/drivers/** whitelist would otherwise un-ignore
packages/drivers/**/.DS_Store
packages/drivers/**/target/
packages/drivers/**/node_modules/

# Test config (contains API keys)
.env.test
src-tauri/tests/.env.test

# Vitest coverage output
coverage/

# Regression sandbox HOME (created by scripts/run-regression.sh / run-e2e-minimal.sh)
.regression-home/

# Duplicate lockfiles (pnpm uses pnpm-lock.yaml; Cargo workspace uses root Cargo.lock)
package-lock.json
src-tauri/Cargo.lock
windows.png
.worktrees/
.superpowers/

# 打包产物：packages/extensions 构建输出（zip 分发包）
packages/extensions/dist/
.pnpm-store/

.dsh-vision-toolkit
tsconfig.node.tsbuildinfo