.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build artifacts and logs
/target
src-tauri/target/
build-logs/
*.log

# Updater keys (keep private)
updater-keys/

# Code signing certificates (keep private)
.certs/
*.p12
*.pfx
*.pem
*.key
!public.key

# Platform-specific build artifacts
*.dmg
*.msi
*.deb
*.AppImage
*.rpm
*.pkg

# Temporary files
*.tmp
*.temp
.cache/
.ssh*
dist/

# E2E SQLite fixture (generated by e2e/create-sqlite-test-db.mjs)
e2e/fixtures/test.db
e2e/fixtures/*.db-shm
e2e/fixtures/*.db-wal

# E2E environment variables (contain credentials)
e2e/.env

# Plugin build artifacts (generated by resolve-plugins.mjs)
.plugin-features.json
.plugins-dev.json
.plugin-file-stash/
/.plugins/
/plugins/

# Test config (contains API keys)
.env.test
src-tauri/tests/.env.test

# Vitest coverage output
coverage/

# Duplicate lockfiles (pnpm uses pnpm-lock.yaml; Cargo workspace uses root Cargo.lock)
package-lock.json
src-tauri/Cargo.lock
windows.png
.worktrees/
.superpowers/
