.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build artifacts and logs
/target
src-tauri/target/
# Tauri v2 capability JSON schemas (regenerated by tauri-build)
src-tauri/gen/
build-logs/
*.log

# Updater keys (keep private)
updater-keys/

# Code signing certificates (keep private)
.certs/
*.p12
*.pfx
*.pem
*.key
!public.key

# Platform-specific build artifacts
*.dmg
*.msi
*.deb
*.AppImage
*.rpm
*.pkg

# Temporary files
*.tmp
*.temp
.cache/
.ssh*
dist/

# E2E SQLite fixture (generated by e2e/create-sqlite-test-db.mjs)
e2e/fixtures/test.db
e2e/fixtures/*.db-shm
e2e/fixtures/*.db-wal

# E2E environment variables (contain credentials)
e2e/.env

# Plugin build artifacts (generated by resolve-drivers.mjs)
.plugin-features.json
.plugins-dev.json
.drivers-dev.json
.plugin-file-stash/
/.plugins/
/plugins/

# Driver selection codegen (written by resolve-drivers.mjs; not committed)
src/plugins/generated.ts
src/plugins/generated-locales.ts
src-tauri/src/plugin_init.rs

# Generated capabilities (merged from default_host.json + plugin capabilities by resolve-drivers.mjs)
src-tauri/capabilities/default.json

# Git-cloned / locally-linked drivers (not committed path builtins)
/packages/drivers/*
!/packages/drivers/clickhouse/
!/packages/drivers/clickhouse/**
!/packages/drivers/duckdb/
!/packages/drivers/duckdb/**
!/packages/drivers/elasticsearch/
!/packages/drivers/elasticsearch/**
!/packages/drivers/hbase/
!/packages/drivers/hbase/**
!/packages/drivers/http-support/
!/packages/drivers/http-support/**
!/packages/drivers/influxdb/
!/packages/drivers/influxdb/**
!/packages/drivers/mongodb/
!/packages/drivers/mongodb/**
!/packages/drivers/mysql/
!/packages/drivers/mysql/**
!/packages/drivers/postgres/
!/packages/drivers/postgres/**
!/packages/drivers/redis/
!/packages/drivers/redis/**
!/packages/drivers/rqlite/
!/packages/drivers/rqlite/**
!/packages/drivers/sqlite/
!/packages/drivers/sqlite/**
!/packages/drivers/sqlserver/
!/packages/drivers/sqlserver/**
!/packages/drivers/turso/
!/packages/drivers/turso/**
!/packages/drivers/vector/
!/packages/drivers/vector/**
