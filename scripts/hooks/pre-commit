#!/bin/sh
#
# Pre-commit hook: prevents committing Cargo.toml with injected plugin content.
# Install: git config core.hooksPath scripts/hooks

has_injected_content() {
  local file="$1"
  # Check if there's any non-comment, non-empty line between the plugin markers
  sed -n '/# <<plugin-/,/# <<\//p' "$file" 2>/dev/null \
    | grep -v '^#' \
    | grep -v '^$' \
    | grep -q .
}

errors=0

if git diff --cached --name-only | grep -q "^src-tauri/Cargo.toml$"; then
  # Check the staged version, not the working directory
  if git show :src-tauri/Cargo.toml | sed -n '/# <<plugin-/,/# <<\//p' | grep -v '^#' | grep -v '^$' | grep -q .; then
    echo "ERROR: src-tauri/Cargo.toml contains injected plugin dependencies."
    errors=1
  fi
fi

if git diff --cached --name-only | grep -q "^Cargo.toml$"; then
  if git show :Cargo.toml | sed -n '/# <<plugin-/,/# <<\//p' | grep -v '^#' | grep -v '^$' | grep -q .; then
    echo "ERROR: Cargo.toml contains injected plugin patches."
    errors=1
  fi
fi

if [ $errors -ne 0 ]; then
  echo ""
  echo "Run 'node scripts/resolve-plugins.mjs --plugins=none' to clean up,"
  echo "or 'git checkout -- Cargo.toml src-tauri/Cargo.toml' to revert."
  echo ""
  echo "Commit aborted."
  exit 1
fi
