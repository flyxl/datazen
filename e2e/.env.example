# E2E Test Environment Variables
# Copy this file to e2e/.env and fill in your values.

# PostgreSQL
# Homebrew installs often use the OS username (not "postgres").
# E2E_PG_DB is the locked logical database for Host specs (created by e2e/setup-e2e-env.sh).
E2E_PG_HOST=localhost
E2E_PG_PORT=5432
E2E_PG_DB=datazen_e2e
E2E_PG_USER=postgres
E2E_PG_PASSWORD=
E2E_PG_SUPER=postgres

# Isolated demo databases for site screenshots (e2e/setup-demo-data.sh + zz-screenshots.ts).
# Uses a restricted PG role so the screenshot tree only expands demo objects.
E2E_DEMO_PG_DB=datazen_demo
E2E_DEMO_PG_DB2=datazen_demo_analytics
E2E_DEMO_PG_USER=datazen_demo
E2E_DEMO_PG_PASSWORD=datazen_demo
E2E_DEMO_MYSQL_DB=datazen_demo
E2E_DEMO_MYSQL_USER=datazen_demo
E2E_DEMO_MYSQL_PASSWORD=datazen_demo

# PostgreSQL read-only user (for permission tests)
E2E_PG_RO_USER=datazen_readonly
E2E_PG_RO_PASSWORD=changeme

# MySQL
E2E_MYSQL_HOST=127.0.0.1
E2E_MYSQL_PORT=3306
E2E_MYSQL_DB=datazen_test
E2E_MYSQL_USER=root
E2E_MYSQL_PASSWORD=
E2E_MYSQL_RO_USER=datazen_readonly
E2E_MYSQL_RO_PASSWORD=changeme

# Redis (standalone — packages/drivers/redis/e2e/redis.ts; pnpm e2e:redis)
E2E_REDIS_HOST=127.0.0.1
E2E_REDIS_PORT=6379
E2E_REDIS_PASSWORD=

# Redis Cluster (optional — e2e/specs/redis-topology.ts; skipped unless set)
# Comma- or newline-separated seed nodes (host:port)
E2E_REDIS_CLUSTER_NODES=127.0.0.1:7000,127.0.0.1:7001,127.0.0.1:7002
E2E_REDIS_CLUSTER_PASSWORD=

# Redis Sentinel (optional — e2e/specs/redis-topology.ts; skipped unless set)
E2E_REDIS_SENTINEL_NODES=127.0.0.1:26379,127.0.0.1:26380,127.0.0.1:26381
E2E_REDIS_SENTINEL_MASTER_NAME=mymaster
E2E_REDIS_SENTINEL_PASSWORD=
E2E_REDIS_SENTINEL_NODE_PASSWORD=

# Kiwi (optional; prefer datazen-driver-kiwi/e2e/.env and `pnpm e2e:kiwi` there)
E2E_KIWI_URL=https://kiwi.akusre.com
E2E_KIWI_TOKEN=
E2E_KIWI_USERNAME=
E2E_KIWI_DOMAIN=
E2E_KIWI_SOURCE_TYPE=4

# Superset (optional; prefer datazen-driver-superset/e2e/.env and `pnpm e2e:superset` there)
E2E_SUPERSET_URL=https://superset.akulaku.com
E2E_SUPERSET_USERNAME=
E2E_SUPERSET_PASSWORD=

# AI (for AI feature E2E tests)
# Options for provider: open_ai | anthropic | deepseek | ollama | custom
E2E_AI_PROVIDER=open_ai
E2E_AI_ENDPOINT=https://token.sensenova.cn/v1
E2E_AI_API_KEY=
E2E_AI_MODEL=glm-5.2

# ── Tunnel (optional — e2e/specs/journeys/tunnel-connection-journey.ts) ──
# When unset, the journey only exercises the tunnel form UI (no live tunnel).
# Fill these to also run a real Test Connection through the chosen tunnel.

# SSH tunnel (bastion / jump host)
E2E_SSH_HOST=
E2E_SSH_PORT=22
E2E_SSH_USER=
E2E_SSH_PASSWORD=
# private_key | password | agent
E2E_SSH_AUTH_METHOD=password
E2E_SSH_PRIVATE_KEY_PATH=
E2E_SSH_PASSPHRASE=

# HTTP CONNECT proxy tunnel
E2E_HTTP_PROXY_HOST=
E2E_HTTP_PROXY_PORT=8080
# http | https
E2E_HTTP_PROXY_SCHEME=http
E2E_HTTP_PROXY_USER=
E2E_HTTP_PROXY_PASSWORD=
E2E_HTTP_PROXY_TIMEOUT_SECS=30

# WebSocket tunnel relay
E2E_WS_TUNNEL_URL=
E2E_WS_TUNNEL_MODE=datazen_v1
E2E_WS_TUNNEL_TOKEN=
E2E_WS_TUNNEL_TIMEOUT_SECS=30

# Target DB when testing via tunnel (defaults to E2E_PG_* if empty)
E2E_TUNNEL_DB_HOST=
E2E_TUNNEL_DB_PORT=
E2E_TUNNEL_DB_NAME=
E2E_TUNNEL_DB_USER=
E2E_TUNNEL_DB_PASSWORD=
