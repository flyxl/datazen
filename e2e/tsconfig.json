{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["@wdio/globals/types", "@wdio/mocha-framework"]
  },
  // The Pro package's specs import `../../../../../e2e/helpers.js`, so they
  // belong to this project. They were typechecked by nothing at all before this
  // entry — `pnpm typecheck` runs the root tsconfig, whose `include` does not
  // reach `e2e/` — which is how a spec can sit in a suite with a broken import
  // and still be reported as clean, by never being asked.
  "include": [
    "**/*.ts",
    "../packages/pro-extensions/*/e2e/**/*.ts",
    "../packages/drivers/sqlserver/e2e/**/*.ts"
  ]
}
