{
  "postgres": {
    "source": "path",
    "path": "packages/drivers/postgres",
    "feature": "plugin-postgres",
    "description": "PostgreSQL + QuestDB/Cloudberry wire reuse"
  },
  "mysql": {
    "source": "path",
    "path": "packages/drivers/mysql",
    "feature": "plugin-mysql",
    "description": "MySQL / MariaDB + Doris/StarRocks/Manticore/OceanBase wire reuse"
  },
  "sqlite": {
    "source": "path",
    "path": "packages/drivers/sqlite",
    "feature": "plugin-sqlite",
    "description": "SQLite driver"
  },
  "redis": {
    "source": "path",
    "path": "packages/drivers/redis",
    "feature": "plugin-redis",
    "description": "Redis key-value store",
    "tauriPlugin": {
      "id": "redis",
      "initFn": "datazen_driver_redis::init",
      "commands": ["set_string", "hash_set", "hash_del", "list_push", "list_set", "list_pop", "set_add", "set_remove", "zset_add", "zset_remove", "delete_keys", "rename", "set_ttl", "batch_delete_pattern", "batch_set_ttl", "batch_rename_prefix", "flush_db", "flush_all", "count_matching"]
    }
  },
  "mongodb": {
    "source": "path",
