{
  "name": "datazen",
  "private": true,
  "version": "0.0.9",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/generate-menu-labels.mjs && tsc && vite build",
    "build:with-drivers": "node scripts/generate-menu-labels.mjs && node scripts/with-plugin-inject.mjs -- sh -c \"tsc && vite build\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "drivers:resolve": "node scripts/resolve-drivers.mjs",
    "drivers:restore": "node scripts/plugin-file-stash.mjs restore",
    "menu:labels": "node scripts/generate-menu-labels.mjs",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/generate-menu-labels.mjs && node scripts/with-plugin-inject.mjs -- tauri build",
    "tauri:build:minimal": "node scripts/generate-menu-labels.mjs && node scripts/with-plugin-inject.mjs --drivers=basic -- tauri build",
    "e2e": "node e2e/run.mjs",
    "e2e:minimal": "node e2e/run.mjs --minimal-drivers",
    "e2e:skip-build": "node e2e/run.mjs --skip-build",
    "e2e:wdio": "wdio run e2e/wdio.conf.ts",
    "e2e:core": "node e2e/run.mjs --skip-build -- --spec e2e/specs/main-window.ts,e2e/specs/new-connection.ts,e2e/specs/edit-delete-connection.ts,e2e/specs/connection-search-group.ts,e2e/specs/settings.ts,e2e/specs/i18n-menu.ts,e2e/specs/homepage-features.ts,e2e/specs/drag-drop-groups.ts,e2e/specs/backup-database.ts",
    "e2e:db": "node e2e/run.mjs --skip-build -- --spec e2e/specs/connection-window.ts,e2e/specs/sql-query.ts,e2e/specs/table-data.ts,e2e/specs/table-edit.ts,e2e/specs/table-structure.ts,e2e/specs/export-import.ts,e2e/specs/data-types.ts,e2e/specs/mysql.ts,e2e/specs/mysql-multi-database.ts,e2e/specs/postgres-multi-database.ts,e2e/specs/data-sync-real.ts",
    "e2e:kiwi": "node e2e/run.mjs --skip-build -- --spec e2e/specs/kiwi.ts",
    "e2e:redis": "node e2e/run.mjs --skip-build -- --spec e2e/specs/redis.ts,e2e/specs/redis-topology.ts",
    "e2e:ai": "node e2e/run.mjs --skip-build -- --spec e2e/specs/ai-features.ts,e2e/specs/ai-context.ts,e2e/specs/ai-context-tables.ts",
    "e2e:i18n-backup": "node e2e/run.mjs --skip-build -- --spec e2e/specs/app-data-backup.ts,e2e/specs/i18n-10-locales.ts,e2e/specs/system-locale.ts,e2e/specs/i18n-menu.ts",
    "e2e:path-ipc": "node e2e/run.mjs --skip-build -- --spec e2e/specs/path-ipc-hardening.ts,e2e/specs/workflow-window.ts,e2e/specs/driver-commands.ts,e2e/specs/app-data-backup.ts",
    "e2e:dashboard": "node e2e/run.mjs --minimal-drivers -- --spec e2e/specs/ops-dashboard.ts",
    "pretest": "node scripts/resolve-drivers.mjs --drivers=basic",
    "posttest": "node scripts/plugin-file-stash.mjs restore",
    "pretest:unit": "node scripts/resolve-drivers.mjs --drivers=basic",
    "posttest:unit": "node scripts/plugin-file-stash.mjs restore",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:scripts": "vitest run scripts/__tests__",
    "test:rust:backup-i18n": "cargo test -p datazen --lib app_data_archive && cargo test -p datazen --lib i18n_locale && cargo test -p datazen --lib store::tests",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.487.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "fflate": "^0.8.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@iamtraction/google-translate": "^3.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.9.0",
    "expect-webdriverio": "^5.6.5",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "opencc-js": "^1.4.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^4.1.10"
  }
}
