{
  "name": "datazen",
  "private": true,
  "version": "0.1.2",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/ensure-generated-drivers.mjs && node scripts/generate-builtin-locales.mjs && node scripts/generate-menu-labels.mjs && tsc --noEmit && vite build",
    "build:with-drivers": "node scripts/generate-builtin-locales.mjs && node scripts/generate-menu-labels.mjs && node scripts/with-driver-inject.mjs -- sh -c \"tsc --noEmit && vite build\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "drivers:resolve": "node scripts/resolve-drivers.mjs",
    "drivers:codegen": "node scripts/resolve-drivers.mjs --codegen-only",
    "drivers:restore": "node scripts/driver-file-stash.mjs restore",
    "menu:labels": "node scripts/generate-menu-labels.mjs",
    "locales:generate": "node scripts/generate-builtin-locales.mjs",
    "locales:list": "node scripts/generate-builtin-locales.mjs list",
    "locales:add": "node scripts/generate-builtin-locales.mjs add",
    "locales:remove": "node scripts/generate-builtin-locales.mjs remove",
    "tauri:dev": "node scripts/tauri-dev.mjs",
    "tauri:build": "node scripts/generate-builtin-locales.mjs && node scripts/generate-menu-labels.mjs && node scripts/with-driver-inject.mjs -- tauri build",
    "tauri:build:minimal": "node scripts/generate-builtin-locales.mjs && node scripts/generate-menu-labels.mjs && node scripts/with-driver-inject.mjs --drivers=basic -- tauri build",
    "ext:pack": "node scripts/pack-extensions.mjs",
    "e2e": "node e2e/run.mjs",
    "e2e:minimal": "node e2e/run.mjs --minimal-drivers",
    "e2e:skip-build": "node e2e/run.mjs --skip-build",
    "e2e:screenshot": "node e2e/run.mjs --skip-build --screenshot",
    "e2e:core": "node e2e/run.mjs --skip-build -- --suite core",
    "e2e:smoke": "node e2e/run.mjs --skip-build -- --suite smoke",
    "e2e:contract:matrix": "node e2e/run.mjs --skip-build -- --suite contract",
    "e2e:contract:pg": "node e2e/run.mjs --skip-build -- --suite contract --mochaOpts.grep 'Host contract @ postgres'",
    "e2e:db": "node e2e/run.mjs --skip-build -- --suite db",
    "e2e:kiwi": "node -e \"console.error('Kiwi E2E: cd datazen-driver-kiwi && pnpm e2e:kiwi'); process.exit(1)\"",
    "e2e:superset": "node -e \"console.error('Superset E2E: cd datazen-driver-superset && pnpm e2e:superset'); process.exit(1)\"",
    "e2e:redis": "node e2e/run.mjs --skip-build -- --suite redis",
    "e2e:ai": "node e2e/run.mjs --skip-build -- --suite ai",
    "e2e:i18n-backup": "node e2e/run.mjs --skip-build -- --suite i18n-backup",
    "e2e:path-ipc": "node e2e/run.mjs --skip-build -- --suite path-ipc",
    "e2e:dashboard": "node e2e/run.mjs --skip-build -- --suite dashboard",
    "e2e:journeys": "node e2e/run.mjs --skip-build --screenshot -- --suite journeys",
    "e2e:data-transfer": "bash e2e/setup-data-transfer-e2e.sh && node e2e/run.mjs --skip-build -- --suite data-transfer",
    "e2e:data-transfer:build": "bash e2e/setup-data-transfer-e2e.sh && node e2e/run.mjs -- --suite data-transfer",
    "e2e:data-sync": "node e2e/run.mjs --skip-build --screenshot -- --suite data-sync",
    "e2e:schema-diff": "bash e2e/setup-schema-diff-e2e.sh && node e2e/run.mjs --skip-build -- --suite schema-diff",
    "e2e:schema-diff:build": "bash e2e/setup-schema-diff-e2e.sh && node e2e/run.mjs -- --suite schema-diff",
    "e2e:demo": "bash e2e/record-demo.sh",
    "e2e:demo:skip-build": "bash e2e/record-demo.sh --skip-build",
    "pretest": "node scripts/resolve-drivers.mjs --codegen-only --drivers=basic && node scripts/generate-builtin-locales.mjs",
    "posttest": "node scripts/driver-file-stash.mjs restore",
    "pretest:unit": "node scripts/resolve-drivers.mjs --codegen-only --drivers=basic && node scripts/generate-builtin-locales.mjs",
    "posttest:unit": "node scripts/driver-file-stash.mjs restore",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:drivers": "vitest run --config vitest.drivers.config.ts",
    "test:unit:e2e-contract": "vitest run --config vitest.e2e-contract.config.ts",
    "test:unit:e2e-contract:coverage": "vitest run --coverage --config vitest.e2e-contract.config.ts",
    "test:unit:coverage": "vitest run --coverage",
    "test:ids": "node scripts/check-id-terminology.mjs",
    "test:scripts": "vitest run scripts/__tests__",
    "test:rust:backup-i18n": "cargo test -p datazen --lib app_data_archive && cargo test -p datazen --lib i18n_locale && cargo test -p datazen --lib store::tests",
    "prepare": "husky && node scripts/ensure-generated-drivers.mjs && node scripts/generate-builtin-locales.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@lezer/highlight": "^1.2.3",
    "@tanstack/react-virtual": "^3.13.6",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.2.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.487.0",
    "marked": "^18.0.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1",
    "sql-formatter": "^15.6.10",
    "tailwind-merge": "^2.6.0",
    "fflate": "^0.8.3",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@iamtraction/google-translate": "^3.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@wdio/cli": "^9.27.0",
    "@wdio/globals": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^9.27.0",
    "@wdio/spec-reporter": "^9.27.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.9.0",
    "expect-webdriverio": "^5.6.5",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "opencc-js": "^1.4.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^4.1.10"
  }
}
