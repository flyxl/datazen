    { "id": "between-array-blank-upper", "operator": "between", "value_kind": "json_array", "value": ["10", "   "], "expected_complete": false },
    { "id": "between-array-null-lower", "operator": "between", "value_kind": "json_array", "value": [null, "10"], "expected_complete": false },
    { "id": "between-array-null-upper", "operator": "between", "value_kind": "json_array", "value": [10, null], "expected_complete": false },
    { "id": "between-array-both-empty", "operator": "between", "value_kind": "json_array", "value": ["", ""], "expected_complete": false },

    { "id": "between-string-empty-upper", "operator": "between", "value_kind": "string", "value": "10,", "expected_complete": false },
