#!/usr/bin/env sh
# Format Rust and frontend code before the commit, then restore plugin-managed files.

set -e

# Snapshot the .rs files staged for THIS commit before rustfmt runs. Only these
# are re-staged afterwards: a blanket `git add -- '*.rs'` would also sweep any
# unstaged, in-progress Rust work in the working tree into an unrelated commit.
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rs' || true)

# Format the Rust workspace.
cargo fmt --all

# Stage the formatted version of the files that were staged anyway.
if [ -n "$STAGED_RS" ]; then
  printf '%s\n' "$STAGED_RS" | tr '\n' '\0' \
    | git add --pathspec-from-file=- --pathspec-file-nul
fi

# Format staged frontend/source files with project-local Prettier.
# prettier is pinned in devDependencies for reproducible formatting across the team.
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|css|scss|less|html)$' || true)
if [ -n "$FRONTEND_FILES" ]; then
  npx --no-install prettier --write --ignore-unknown $FRONTEND_FILES
  git add -- $FRONTEND_FILES
fi

# Restore driver-injected tracked files (Cargo.toml / capabilities).
# Implementation lives in scripts/driver-stash-precommit.mjs for testability.
node scripts/driver-stash-precommit.mjs

# Guard version consistency across package.json / Cargo.toml / tauri.conf.json.
node scripts/check-version-consistency.mjs
