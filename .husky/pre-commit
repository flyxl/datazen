#!/usr/bin/env sh
# Format Rust and frontend code before the commit, then restore plugin-managed files.

set -e

# Format the Rust workspace.
cargo fmt --all

# Stage any files changed by rustfmt so the formatted version is committed.
git add -- '*.rs'

# Format staged frontend/source files with a pinned Prettier version.
# Prettier is intentionally invoked through pnpm so developers do not need a global install.
FRONTEND_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|css|scss|less|html)$' || true)
if [ -n "$FRONTEND_FILES" ]; then
  pnpm dlx --quiet prettier@3.6.2 --write --ignore-unknown $FRONTEND_FILES
  git add -- $FRONTEND_FILES
fi

# Restore plugin-injected tracked files (Cargo.toml / capabilities).
# Implementation lives in scripts/plugin-stash-precommit.mjs for testability.
node scripts/plugin-stash-precommit.mjs
