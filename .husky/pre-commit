# Auto-fix plugin-injected content in committed files.
# If any of the 4 plugin-affected files are staged with injected content,
# run resolve-plugins.mjs --plugins=none to clean them, then re-stage.

AFFECTED_FILES="src-tauri/Cargo.toml Cargo.toml src-tauri/src/plugin_init.rs src/plugins/generated.ts"

has_staged_affected() {
  for f in $AFFECTED_FILES; do
    if git diff --cached --name-only | grep -q "^${f}$"; then
      return 0
    fi
  done
  return 1
}

has_injected_cargo_content() {
  local file="$1"
  if git diff --cached --name-only | grep -q "^${file}$"; then
    if git show ":${file}" | sed -n '/# <<plugin-/,/# <<\//p' | grep -v '^#' | grep -v '^$' | grep -q .; then
      return 0
    fi
  fi
  return 1
}

has_injected_plugin_init() {
  if git diff --cached --name-only | grep -q "^src-tauri/src/plugin_init.rs$"; then
    if git show ":src-tauri/src/plugin_init.rs" | grep -q "extern crate"; then
      return 0
    fi
  fi
  return 1
}

has_injected_generated_ts() {
  if git diff --cached --name-only | grep -q "^src/plugins/generated.ts$"; then
    if git show ":src/plugins/generated.ts" | grep -q "PluginDatabaseType = "; then
      local type_line
      type_line=$(git show ":src/plugins/generated.ts" | grep "PluginDatabaseType = ")
      if echo "$type_line" | grep -qv "= never"; then
        return 0
      fi
    fi
  fi
  return 1
}

needs_fix=0

has_injected_cargo_content "src-tauri/Cargo.toml" && needs_fix=1
has_injected_cargo_content "Cargo.toml" && needs_fix=1
has_injected_plugin_init && needs_fix=1
has_injected_generated_ts && needs_fix=1

if [ $needs_fix -eq 1 ]; then
  echo "[pre-commit] Detected injected plugin content. Auto-cleaning..."
  node scripts/resolve-plugins.mjs --plugins=none > /dev/null 2>&1

  for f in $AFFECTED_FILES; do
    if git diff --cached --name-only | grep -q "^${f}$"; then
      git add "$f"
    fi
  done

  echo "[pre-commit] Cleaned and re-staged affected files."
fi
