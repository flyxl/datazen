{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@datazen/driver-sdk": ["./packages/driver-sdk/src/index.ts"],
      "@datazen/extension-points": ["./packages/extension-points/src/index.ts"],
      "@datazen/app-sdk": ["./packages/app-sdk/src/index.ts"],
      "@datazen/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "@datazen/extension-sdk": ["./packages/app-sdk/src/index.ts"],
      "@datazen/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["src", "packages/driver-sdk", "packages/extension-points", "packages/app-sdk", "packages/ui"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "packages/**/__tests__/**",
    "packages/**/*.test.ts",
    "packages/**/*.test.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
